# Knowledge Forge — local environment configuration.
#
# Copy to .env and adjust:   cp .env.example .env
#
# The SAME .env file is read by PHP-FPM and by the cron worker, because both run as the same user and
# load it from this path. That is what keeps web and worker configuration identical. Verify it with:
#
#     ./yii kf:health                       # as the deployment user
#     sudo -u www-data ./yii kf:health      # as the web/cron user
#
# The two runs must print the SAME config fingerprint. A mismatch means one tier is reading a different
# file or a stale FPM pool env[] block.
#
# Permissions in production:
#     sudo chown <deploy_user>:www-data .env && sudo chmod 0640 .env
#
# Variables already present in the process environment always win over this file, so FPM pool env[] or
# systemd EnvironmentFile= still work. If you use those instead of .env, you MUST replicate every
# variable to the cron environment as well.

# ── Application ───────────────────────────────────────────────────────────────
# APP_ENV: dev | test | prod
APP_ENV=dev
# Never enable APP_DEBUG in production: it renders stack traces and request state to the browser.
APP_DEBUG=true
APP_C3=false
# The one application timezone for business/scheduling/display (daily sync at 02:00/03:00 local, the NY
# calendar date used for daily idempotency, and user-facing time formatting). Database storage stays UTC.
# A named IANA zone so DST (EST/EDT) is handled automatically — never a fixed UTC offset.
APP_TIMEZONE=America/New_York
# URL prefix this application is served under. Leave empty when it owns the domain root. Set it when
# the application is mounted on a sub-path (e.g. https://example.com/knowledge-forge/): it strips the
# prefix before routing and puts it back on every generated link, redirect and asset URL. Must match
# the web server location prefix exactly.
# APP_BASE_PATH=/knowledge-forge
# Only used by the debug error page to turn container paths into clickable editor links. Leave unset
# in production.
# APP_HOST_PATH=/var/www/html/knowledge-forge

# ── Authentication throttle ────────────────────────────────────────────────────
# Failed logins are throttled per username+IP: MAX attempts within WINDOW minutes triggers a LOCKOUT.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=knowledge_forge_db
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Set this if MySQL listens on a unix socket rather than TCP (common on Ubuntu, and the case when
# mysqld runs with --skip-networking). When set, DB_HOST and DB_PORT are ignored.
# Find the path with:  mysql -e "SELECT @@socket;"
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ── OpenAI: credentials ───────────────────────────────────────────────────────
OPENAI_API_KEY=
# OPTIONAL. Only needed for the admin usage dashboard's organization billing, File Search call
# history and token-usage sections. It must be an ORGANIZATION admin key, not a project key — leaving
# it blank is normal and supported: those sections simply report "Unavailable" and every other figure
# on the page (vector store inventory, storage, estimated cost) still works from OPENAI_API_KEY.
OPENAI_ADMIN_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1

# ── OpenAI: models ────────────────────────────────────────────────────────────
# Intentionally BLANK. There is no safe default model id — an id your account cannot access fails at
# runtime, and guessing one is worse than refusing to start. Set both, then run:
#
#     ./yii kf:openai:ping
#
# which verifies (a) the model exists and your key can reach it, and (b) it actually supports what we
# need: hosted file_search with a forced tool_choice for the chat model, and image input for the vision
# model. AI features refuse to run while these are empty.
OPENAI_CHAT_MODEL=
OPENAI_VISION_MODEL=

# ── OpenAI: chat profile (the one synchronous call, made from the web tier) ────
# Keep TIMEOUT x (1 + MAX_RETRIES) + backoff below the Nginx fastcgi_read_timeout (120s).
# "./yii kf:health" computes this bound and warns if the two drift apart.
OPENAI_CHAT_CONNECT_TIMEOUT_SECONDS=5
OPENAI_CHAT_TIMEOUT_SECONDS=45
OPENAI_CHAT_MAX_RETRIES=1
OPENAI_CHAT_RETRY_MAX_BACKOFF_SECONDS=2

# ── OpenAI: worker profile (background ingestion, driven by cron) ──────────────
OPENAI_WORKER_CONNECT_TIMEOUT_SECONDS=10
OPENAI_WORKER_TIMEOUT_SECONDS=120
OPENAI_WORKER_MAX_RETRIES=3
OPENAI_WORKER_RETRY_MAX_BACKOFF_SECONDS=60

# ── OpenAI: retrieval ─────────────────────────────────────────────────────────
OPENAI_FILE_SEARCH_MAX_RESULTS=8
OPENAI_INDEX_POLL_INTERVAL_SECONDS=3
OPENAI_INDEX_POLL_MAX_SECONDS=60

# ── Storage and upload limits ─────────────────────────────────────────────────
# Path aliases (@runtime, @root) are resolved by the application. Uploaded files are stored OUTSIDE
# public/ and are never served by the web server.
KNOWLEDGE_STORAGE_PATH=@runtime/storage
# Keep MAX_UPLOAD_SIZE_MB <= Nginx client_max_body_size <= PHP post_max_size / upload_max_filesize.
MAX_UPLOAD_SIZE_MB=25
# Images are sent to the vision model as base64, so this cap also bounds worker memory.
MAX_IMAGE_UPLOAD_SIZE_MB=8
MAX_DOCUMENTS_PER_KNOWLEDGE_BASE=200
IMAGE_MAX_WIDTH=12000
IMAGE_MAX_HEIGHT=12000

# ── Background worker ─────────────────────────────────────────────────────────
# One document per run is deliberate on a shared server: it bounds memory, OpenAI spend and blast
# radius. Raise only after watching runtime/logs/worker.log.
DOCUMENT_WORKER_BATCH_SIZE=1
DOCUMENT_MAX_PROCESSING_ATTEMPTS=3
DOCUMENT_PROCESSING_TIMEOUT_MINUTES=20
DOCUMENT_RETRY_BASE_SECONDS=60
DOCUMENT_WORKER_LOCK_PATH=@runtime/locks/worker.lock
AI_OPERATION_MAX_ATTEMPTS=5
AI_OPERATION_RECONCILE_WINDOW_MINUTES=120

# ── PDF ingestion policy ──────────────────────────────────────────────────────
# A PDF is indexed directly only on positive evidence of a text layer. Anything else goes to vision
# extraction; if vision is not possible within these bounds the document is failed for manual review
# rather than silently indexed as empty.
PDF_MIN_TEXT_CHARS_PER_PAGE=100
PDF_TEXT_PROBE_MAX_BYTES=26214400
PDF_VISION_MAX_PAGES=50
PDF_VISION_MAX_BYTES=26214400

# ── Chat ──────────────────────────────────────────────────────────────────────
CHAT_HISTORY_MESSAGE_LIMIT=10
CHAT_HISTORY_CHAR_LIMIT=8000
CHAT_MAX_QUESTION_LENGTH=2000
CHAT_MAX_OUTPUT_TOKENS=1200
# With this on, an answer that resolves to zero citations is replaced by the fallback message rather
# than shown as fact.
CHAT_REQUIRE_CITATIONS=true
CHAT_FORCE_FILE_SEARCH=true
# 0.0 accepts any result the retrieval returns. Raise this first if low-relevance citations appear.
CHAT_MIN_CITATION_SCORE=0.0
CHAT_FALLBACK_MESSAGE="I could not find enough information in the selected knowledge base to answer that question."

# ── Order58 ───────────────────────────────────────────────────────────────────
# ORDER58_API_BASE_URL=
# ORDER58_API_TOKEN=
# ORDER58_API_CONNECT_TIMEOUT_SECONDS=10
# ORDER58_API_TIMEOUT_SECONDS=30
# ORDER58_API_MAX_RETRIES=2
# ORDER58_API_RETRY_MAX_BACKOFF_SECONDS=30
# ORDER58_API_PAGE_SIZE=100
# ORDER58_SYNC_MAX_ATTEMPTS=3
# ORDER58_SYNC_PAGES_PER_RUN=1000
# Show Order58 "Store profile" rows on the knowledge-base documents list.
# false = hide from the UI list (default). true = show.
# Does not delete or un-index the profile — list visibility only.
ORDER58_SHOW_STORE_PROFILE_DOCUMENTS=true

# Fallback agent credential validation. A DIFFERENT Order58 API from the Integration API above, called
# only when that API explicitly rejects an agent's username/password. Leave both empty to disable the
# fallback entirely. The token is a static application credential, not a user session token.
# ORDER58_VALIDATE_API_URL=https://order58.com/api/user/validate
# ORDER58_VALIDATE_API_TOKEN=
# ORDER58_VALIDATE_CONNECT_TIMEOUT_SECONDS=3
# ORDER58_VALIDATE_TIMEOUT_SECONDS=5
# How stale an order58_agents row may be and still authorize a fallback login.
# 72h tolerates two missed daily agent syncs (kf:order58:schedule-agents, 01:00 America/New_York).
# ORDER58_VALIDATE_MAX_MIRROR_AGE_HOURS=72

# ── Audio to Text ─────────────────────────────────────────────────────────────
# Local speech-to-text. Every stage runs on this machine; no audio is ever sent to an external
# service. Requires ffmpeg, ffprobe and a whisper.cpp build with a multilingual model.
#
# Measured on this hardware (Intel i5-8365U, 4 cores / 8 threads) with a 73.7-second recording:
#   ffmpeg -threads 1     0.07 s,  49 MB peak RSS, 97% of one core
#   whisper-cli -t 1      88-94 s, 834 MB peak RSS, 99% of one core  (real-time factor ~1.27)
# So a recording at the 120-second cap takes about 153 seconds against the 300-second timeout.

# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe
# WHISPER_BINARY=/opt/whisper.cpp/build/bin/whisper-cli
# Multilingual on purpose, NOT ggml-small.en.bin: recordings mix English, Spanish, Gujarati and Hindi,
# and the .en model transcribes all of it as though it were English.
# WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small.bin

# Empty resolves to @runtime/audio-to-text — outside the web root, already writable by www-data, and
# gitignored. Never point this inside public/: a queued recording would be reachable over HTTP.
# AUDIO_TRANSCRIPTION_TEMP_DIR=

# 15 MB. Must stay below nginx client_max_body_size (32m here) and PHP post_max_size (50M here).
# 30 MB. Ceiling is nginx client_max_body_size (32m), not PHP post_max_size.
# AUDIO_TRANSCRIPTION_MAX_SIZE=31457280
# 300 = 5 minutes. The one place the duration cap is set; validation, the
# upload hint and the rejection message all derive from it.
# AUDIO_TRANSCRIPTION_MAX_DURATION=300
# Must be at least MAX_DURATION * 1.5 or the worker refuses to start.
# AUDIO_TRANSCRIPTION_TIMEOUT=600

# One thread, deliberately. whisper measured 99% of a single core at -t 1; raising this lets one demo
# transcription saturate the machine, and the whole pipeline is pinned to one core by design.
# AUDIO_TRANSCRIPTION_THREADS=1
# Cap on QUEUED + PROCESSING jobs across the whole installation. NOT per administrator.
#
#   0  = unlimited  <-- the default, and this project's setting
#   50 = at most 50 waiting or running jobs at any moment
#
# An administrator may queue as many recordings as they like without waiting for earlier ones to
# finish. The worker still processes exactly one at a time — that is enforced by its flock and its
# atomic claim, not by refusing uploads.
# AUDIO_TRANSCRIPTION_MAX_QUEUE=0

# How long a completed conversation is kept.
#
#   0        = keep indefinitely  <-- the default, and this project's setting
#   2592000  = expire after 30 days
#   86400    = expire after 24 hours
#
# This is the ONLY place retention is configured. Changing it needs no code or SQL change: the worker
# reads it, and a job created while it is 0 gets a NULL expiry that no purge query will ever match.
#
# What is kept for a successful job: the original recording, the complete transcript, customer-only and
# agent-only text, the speaker-labelled segments, detected language, duration, uploader and timestamps.
# AUDIO_TRANSCRIPTION_RETENTION_SECONDS=0
# A job PROCESSING longer than this is recovered. If it already produced a transcript the job is
# COMPLETED with the speaker split marked failed; only a crash before transcription fails the job.
# Keep above TRANSCRIPTION_TIMEOUT + DIARIZATION_TIMEOUT (600 + 300 = 900).
# AUDIO_TRANSCRIPTION_STALE_AFTER=1200
# AUDIO_TRANSCRIPTION_WORKER_SLEEP=2

# ── Audio worker liveness and admission control ───────────────────────────────
# The admin page distinguishes "a worker process is alive" from "something is still invoking the
# worker". Under a systemd timer no process exists between ticks, so the second is what proves the
# deployment is healthy.
# AUDIO_WORKER_HEARTBEAT_SECONDS=5
# AUDIO_WORKER_STALE_AFTER=30
# Three missed minute-ticks. Raise to ~90-180 for a timer or cron deployment.
# AUDIO_WORKER_TICK_STALE_AFTER=180

# A tick will not claim a job unless the machine has room. Provisional: 1.8x the measured 834 MB
# whisper peak. Re-derive once speaker separation is enabled and its RSS is known.
# AUDIO_WORKER_MIN_AVAILABLE_MB=1500
# 1-minute load average divided by logical CPUs. 1.5 defers above load 12.0 on this 8-thread box.
# AUDIO_WORKER_MAX_LOAD_PER_CORE=1.5

# Cross-project coordination. Comma-separated lock files belonging to OTHER projects on this machine
# that also run whisper. The worker takes a non-blocking flock on each before claiming a job, so two
# projects cannot start whisper in the same instant — a process scan cannot promise that, because the
# gap between looking and starting is where the race lives.
#
# This host runs telecom-billing's audio cron every minute, and this deployment is configured to
# coordinate with it (see .env):
#   AUDIO_WORKER_FOREIGN_LOCKS=/var/www/html/telecom-billing/runtime/audio-to-text/cron-worker.lock
#
# FAILS CLOSED: a configured lock that is held, missing OR UNREADABLE defers the tick. That matters
# here because that directory is 0750 www-data:www-data — a worker run as any other user cannot read
# it and would defer every tick. Run the worker as www-data, or leave this blank to opt out. The
# worker reports unreadable locks once at startup rather than stalling silently.
# AUDIO_WORKER_FOREIGN_LOCKS=

# Best-effort defence in depth: yields if any whisper-cli is already running. Racy by construction —
# it catches a foreign worker started by hand, and is not an exclusivity guarantee.
# AUDIO_WORKER_YIELD_TO_OTHER_WHISPER=true

# ── Speaker separation (customer / agent split) ───────────────────────────────
# OFF until the local diarization toolchain is installed. Transcription is complete and useful
# without it: jobs still succeed and simply record NOT_SUPPORTED for the split.
#
# whisper.cpp cannot do this. Its -di flag splits stereo channels (useless for a mono phone call) and
# -tdrz needs an English-only model that marks turn boundaries without establishing speaker identity.
# Real diarization needs a segmentation model plus speaker embeddings; see docs/AUDIO_TO_TEXT.md for
# the install commands.
# AUDIO_DIARIZATION_ENABLED=false
# AUDIO_DIARIZATION_BINARY=/opt/audio-diarization/venv/bin/python3
# AUDIO_DIARIZATION_SEGMENTATION_MODEL=/opt/audio-diarization/models/segmentation.onnx
# AUDIO_DIARIZATION_EMBEDDING_MODEL=/opt/audio-diarization/models/embedding.onnx
# AUDIO_DIARIZATION_TIMEOUT=300
# Below this margin the agent/customer mapping is held back as NEEDS_REVIEW rather than published. A
# wrong confident split is worse than an honest one, because nobody re-checks a finished-looking column.
# AUDIO_DIARIZATION_MIN_CONFIDENCE=0.55
# 0 lets the clusterer decide how many speakers there are, instead of fixing it at two.
# AUDIO_DIARIZATION_MAX_SPEAKERS=2
#
# How far a transcribed token may sit outside every detected speech region and still be attributed
# to the nearest speaker, in milliseconds.
#
# Diarization marks *speech*, not the pauses between it, so it typically covers only half to
# two-thirds of a recording, while Whisper's token timestamps run straight across those pauses.
# On the reference call the diarizer left 44% of the audio uncovered across 21 gaps (median 1.2s)
# and, without this tolerance, a third of all tokens were attributed to nobody — which the code
# then misreported as overlapping speech. Measured attribution by token duration: 74% at 0ms,
# 85% at 500ms, 95% at 1000ms, 99% at 1500ms, flat thereafter. 0 disables gap bridging.
# AUDIO_DIARIZATION_BOUNDARY_TOLERANCE_MS=1500
